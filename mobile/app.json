{
  "expo": {
    "name": "Genesis Remote",
    "slug": "genesis-remote",
    "scheme": "genesisremote",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0e14"
    },
    "ios": {
      "bundleIdentifier": "dev.me7ko.genesisremote",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Genesis Remote connects to Genesis running on your computer in the same network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.me7ko.genesisremote",
      "adaptiveIcon": {
        "backgroundColor": "#1a1822",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Genesis",
      "themeColor": "#6d28d9"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera scans the pairing QR code shown by `genesis serve` on your computer.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": { "usesCleartextTraffic": true }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
