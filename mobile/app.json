{
  "expo": {
    "name": "Genesis Remote",
    "slug": "genesis-remote",
    "scheme": "genesisremote",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0e14"
    },
    "ios": {
      "bundleIdentifier": "dev.me7ko.genesisremote",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Genesis Remote connects to Genesis running on your computer in the same network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.me7ko.genesisremote",
      "adaptiveIcon": {
        "backgroundColor": "#1a1822",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Genesis",
      "themeColor": "#6d28d9"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Камерата сканира QR кода за сдвояване с компютъра и снима кадрите, които пращаш на Genesis.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true,
          "microphonePermission": "Микрофонът записва това, което диктуваш; компютърът го прави на текст в полето за писане."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Снимките, които избереш, отиват при Genesis на твоя компютър.",
          "cameraPermission": "Камерата сканира QR кода за сдвояване с компютъра и снима кадрите, които пращаш на Genesis.",
          "microphonePermission": "Микрофонът записва това, което диктуваш; компютърът го прави на текст в полето за писане."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофонът записва това, което диктуваш; компютърът го прави на текст в полето за писане.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
