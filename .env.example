# Genesis Agent — API keys and settings.
#
# Copy this file to ~/.genesis/.env and fill in the keys you have:
#
#     mkdir -p ~/.genesis && cp .env.example ~/.genesis/.env
#     chmod 600 ~/.genesis/.env
#
# Or just run `genesis setup`, which asks for each key and tests it live.
#
# EVERY KEY IS OPTIONAL. Genesis skips any provider it has no key for, so one
# key is enough to start. More providers mean more headroom when one is busy.
#
# ONE key per provider. Genesis deliberately does not rotate several accounts
# of the same provider — see SECURITY.md.


# ─── Model providers (pick at least one) ──────────────────────────────────────

# HuggingFace Inference Router — https://huggingface.co/settings/tokens
HF_TOKEN=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama Cloud (large hosted models) — https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM — https://build.nvidia.com/
NVIDIA_API_KEY=


# ─── Local model (optional, no key needed) ────────────────────────────────────
# If Ollama is running locally, Genesis uses it as the last-resort fallback
# when every cloud provider fails. Leave empty to disable.
#   ollama pull qwen2.5-coder:3b
GENESIS_LOCAL_MODEL=qwen2.5-coder:3b

# Semantic skill search uses a local embedding model via Ollama:
#   ollama pull bge-m3
# Without it, skill search falls back to keyword matching.


# ─── Google Gemini / Vertex AI ────────────────────────────────────────────────
# Два пътя до същите модели. Избери според това какво имаш:
#
# 1) AI Studio — статичен ключ, има безплатен слой, най-лесното.
#    Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
#    Няколко ключа? Виж бележката за ротацията при OLLAMA_API_KEY_2 по-долу —
#    същият механизъм важи за всеки доставчик: GEMINI_API_KEY_2, _3, ...
#
# 2) Vertex AI — твой Google Cloud проект, OAuth вместо ключ. Изисква
#    `pip install 'genesis-agent[google]'` и едно от двете:
#      gcloud auth application-default login
#      GOOGLE_APPLICATION_CREDENTIALS=/път/до/service-account.json
GOOGLE_CLOUD_PROJECT=
#    Локация: `global` (по подразбиране) или регион, напр. us-central1.
GOOGLE_CLOUD_LOCATION=
#    Няколко проекта = няколко отделни квоти, всяка по своята сметка:
#    GOOGLE_CLOUD_PROJECT_2, _3, ... Ротират се при 429, като ключовете.
#    Пълен override на адреса, ако Google го смени:
# GOOGLE_VERTEX_BASE_URL=


# ─── Optional behaviour ───────────────────────────────────────────────────────

# Your name/handle. Only used if GENESIS_STRICT_AUTHORITY=1 below.
GENESIS_OPERATOR=

# Refuse autonomous missions unless the operator matches GENESIS_OPERATOR.
# GENESIS_STRICT_AUTHORITY=1

# Plain questions in the chat ("what is recursion?") go to a small fast model;
# anything that looks like work goes to the strong one. 0 = always the strong one.
# GENESIS_CHAT_ROUTING=1

# Show the browser window while the agent navigates it (off by default —
# headless is faster and works on a server with no display).
# GENESIS_BROWSER_VISIBLE=1

# Where config lives. Default: ~/.genesis
# GENESIS_HOME=

# Where the agent works by default. Default: the project directory.
# GENESIS_WORKSPACE=

