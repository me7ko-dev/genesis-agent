# Настройки на cloud/monitor.py. Копирай в /srv/genesis/monitor.env и:
#   sudo chown root:root /srv/genesis/monitor.env && sudo chmod 600 /srv/genesis/monitor.env
# Паролата за SMTP и адресът на webhook-а са тайни; deploy.sh отказва права,
# различни от 600, и файл с грешна стойност. Проба без пращане:
#   sudo python3 -m cloud.monitor --once --dry-run
# Ред KEY=value; коментарът е на свой ред (# в края на реда става част от стойността).
# Каналите са по желание, може и двата.

# Име на машината в алармите (по подразбиране hostname).
#MONITOR_NAME=genesis-prod

# ── Webhook: POST с JSON ─────────────────────────────────────────────────────
# text     → {"text": …}                 Slack, Mattermost, общ JSON
# discord  → {"content": …}              Discord
# telegram → {"chat_id": …, "text": …}   Telegram бот:
#            MONITOR_WEBHOOK_URL=https://api.telegram.org/bot<жетон>/sendMessage
#MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
#MONITOR_WEBHOOK_FORMAT=text
#MONITOR_TELEGRAM_CHAT_ID=123456789

# ── Имейл по SMTP ────────────────────────────────────────────────────────────
# MONITOR_SMTP_TLS: starttls (порт 587), ssl (порт 465) или none (само локален relay).
#MONITOR_SMTP_HOST=smtp.example.com
#MONITOR_SMTP_PORT=587
#MONITOR_SMTP_TLS=starttls
#MONITOR_SMTP_USER=alerts@example.com
#MONITOR_SMTP_PASSWORD=
#MONITOR_SMTP_FROM=alerts@example.com
#MONITOR_SMTP_TO=operator@example.com,second@example.com

# ── Прагове (тук са подразбиранията) ─────────────────────────────────────────
# Свободно място за /srv/jobs и /srv/genesis/web.
#MONITOR_MIN_FREE_GB=5
# Провалени ходове за последния час.
#MONITOR_MAX_FAILED_TURNS=10
# Похарчени кредити за последния час — на човек и общо.
#MONITOR_MAX_USER_CREDITS_HOUR=200
#MONITOR_MAX_TOTAL_CREDITS_HOUR=1000
# Заключени входове (имейл, IP или покана) за последния час.
#MONITOR_MAX_LOCKOUTS_HOUR=20
# Като --seconds на уеб сървъра; контейнер на задача над това + 2 мин е „висящ“.
#MONITOR_TASK_SECONDS=600
# Таймерът на копието е на 6 часа.
#MONITOR_MAX_BACKUP_HOURS=13
